# Build-time environment variables (Frontend)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini (server-only — used by /api/analyze serverless function, never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Exact hostnames, no wildcards. Add localhost only in local development.
RECAPTCHA_ALLOWED_HOSTNAMES=cvfit.pro,www.cvfit.pro
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FEEDBACK_RECIPIENT_EMAIL=admin@example.com
VITE_FEEDBACK_RECIPIENT_EMAIL=admin@example.com

# PayOS Pro (server-only — Vercel Dashboard / local .env)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://cvfit.pro

# Storage rollout (server-only). Keep supabase until migration, private buckets,
# lifecycle, CORS and scheduled cleanup have passed staging checks.
STORAGE_WRITE_PROVIDER=supabase
# Start with temp; later use temp,saved,candidate after per-phase acceptance.
STORAGE_R2_PURPOSES=temp
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TEMP_BUCKET=
R2_CV_BUCKET=
# At least 32 random characters. Same value in GitHub Actions secrets.
STORAGE_CLEANUP_SECRET=
